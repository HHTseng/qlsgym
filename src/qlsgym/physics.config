# Physical constants and the modelling assumptions of every molecule pack.
# Read by qlsgym.config; QLSGYM_PHYSICS_CONFIG points it at another file.
# Units are in the key names. Angular rates are rad/ms; frequencies over 2 pi are kHz.
# Changing anything under [thf] or [h3o] changes that molecule's fingerprint: rebuild its tables
# if a [*.tables] entry changed, and retrain every surrogate.

[constants]
k_B_over_h_kHz_per_K = 2.0836619123e7          # Boltzmann constant / Planck constant


# 232Th19F+ (X 3Delta1, v = 0) with a Ca+ logic ion

[thf.tables]                                    # heff build of data/thf (qlsgym.molecules.thf_tables)
heff_parameter_set = "thf_v1"
j_max = 7                                       # rotational cutoff J = 1..j_max
b_field_gauss = 20.0                            # B_z
e_field_v_per_cm = 0.0                          # E_z; 0 keeps parity exact, so blocks are (J, parity)
intermediate_extra_j = 1                        # model A intermediate state summed over J'' <= j_max + this
reference_transition = [[1, 1.5, "+", 0.5, 0], [1, 1.5, "+", 1.5, 0]]   # (J, F, parity, m_F, xi) -> ...
reference_rabi_khz = 3.0                        # |Omega|/2pi of the reference rung, fixes the overall scale
min_rel_amplitude = 1e-9                        # couplings below this fraction of the largest are dropped

[thf.trap]
nu_f_khz = 1112.7182                            # ThF+/Ca+ in-phase axial mode
eta = 0.06776                                   # Lamb-Dicke parameter of ThF+ on that mode
n_nu = 8                                        # motional levels propagated; J = 7 needs J + 1

[thf.window]
half_width_khz = 470.0                          # drive window nu_f +- half_width
tau_max_ms = 6.0                                # pulse durations: n_tau points on [0, tau_max], inclusive
n_tau = 200
rwa_cutoff_rad_per_ms = 1.0e6                   # couplings farther than this from the window are dropped
omega_min_coupling_rad_per_ms = 1.0             # weaker couplings get no action or embedding channel
carrier_half_width_khz = 1.0                    # masked band around each in-window carrier
carrier_min_coupling_khz = 0.02                 # carriers weaker than this are not masked

[thf.embedding]                                 # surrogate input (paper Eqs. 11-16)
delta_max_rad_per_ms = 1.0e4
s_emb = 0.05
beta_emb = 0.01

[thf.task]
temperature_k = 4.0                             # Boltzmann prior
p_target = 0.98                                 # success: one population at or above this
max_pulses = 80                                 # task pulse budget

[thf.primitives]                                # cross-J sideband Raman primitives
n = 24
mode = "dark_state"
delta_j = [1, 2]
dedupe_khz = 1.0


# H3O+ (arXiv:2410.11839) with a Ca+ logic ion

[h3o.tables]
levels_file = "H3O_levels_Jmax_4_B_0.00036.txt"
rabi_file = "two_photon_rabi_rates_sum_Jmax_4_p_q10_q21_B_0.00036.txt"
j_max = 4
b_field_mt = 0.36
reference_transition = [[2, 2.0, "-", 1.5, 1], [2, 2.0, "-", 2.5, 1]]
reference_rabi_khz = 2.0

[h3o.trap]
nu_f_khz = 5164.0
eta = 0.09
n_nu = 2

[h3o.window]
omega_min_khz = 5050.0
omega_max_khz = 5300.0
tau_max_ms = 4.0
n_tau = 200
rwa_cutoff_rad_per_ms = 1.0e6
omega_min_coupling_rad_per_ms = 1.0
carrier_half_width_khz = 1.0
carrier_min_coupling_khz = 0.02

[h3o.embedding]
delta_max_rad_per_ms = 1.0e4
s_emb = 0.05
beta_emb = 0.01

[h3o.task]
temperature_k = 20.0
p_target = 0.98
max_pulses = 80

[h3o.primitives]                                # THz rotational primitives
n_families = 2
min_source_population = 0.01


# 229Th19F+ (X 3Delta1, v = 0; I(229Th) = 5/2 and I(19F) = 1/2) with a Ca+ logic ion
# Exploratory: heff marks several 229Th inputs as estimates or placeholders.

[thf229.tables]                                 # heff build of data/thf229 (qlsgym.molecules.thf229_tables)
isotopologue = "229"
heff_parameter_set = "thf_v2"
zeroed_parameters = []                          # Th quadrupoles kept at heff's values (eQq0_Th, eQq2_Th are placeholders)
j_max = 3
b_field_gauss = 20.0
e_field_v_per_cm = 0.0
raman_rank = 2                                  # heff two-photon channel K = 2, dOmega = 0
raman_d_omega = 0
reference_transition = [[1, 3.5, 4.0, "-", 0.0, 0], [1, 3.5, 4.0, "-", 1.0, 0]]   # (J, F1, F, parity, m_F, xi) -> ...
reference_rabi_khz = 3.0
min_rel_amplitude = 1e-9

[thf229.trap]                                   # assumed equal to 232ThF+ (mass 248 vs 251 u)
nu_f_khz = 1112.7182
eta = 0.06776
n_nu = 13                                       # no dark rung: full ladders climb, 2 F_max + 1 for J <= 3

[thf229.window]
half_width_khz = 470.0
tau_max_ms = 6.0
n_tau = 200
rwa_cutoff_rad_per_ms = 1.0e6
omega_min_coupling_rad_per_ms = 1.0
carrier_half_width_khz = 1.0
carrier_min_coupling_khz = 0.02

[thf229.embedding]
delta_max_rad_per_ms = 1.0e4
s_emb = 0.05
beta_emb = 0.01

[thf229.task]
temperature_k = 4.0
p_target = 0.98
max_pulses = 80
